// ── State ─────────────────────────────────────────────────────────────────────
let currentSpec = 'd38999_iii';
let selections = {};

function loadSpec(specId) {
  currentSpec = specId;
  selections = {};
  document.querySelectorAll('.spec-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  renderBuilder();
}

function renderBuilder() {
  const spec = SPECS[currentSpec];
  const fieldsEl = document.getElementById('builderFields');

  fieldsEl.innerHTML = spec.fields.map(field => {
    const isFixed = field.fixed;
    const sel = selections[field.id] || (isFixed ? field.options[0].code : null);

    return `<div class="builder-field" id="field-${field.id}">
      <div class="field-header">
        <span class="field-label">${field.label}</span>
        ${sel && !isFixed ? `<span class="field-selected" style="color:${field.color}">${sel}</span>` : ''}
      </div>
      ${field.note ? `<div class="field-note">ℹ ${field.note}</div>` : ''}
      <div class="field-options ${isFixed ? 'fixed' : ''}">
        ${(isFixed ? field.options : visibleOptions(field)).map(opt => `
          <div class="field-option ${sel === opt.code ? 'selected' : ''} ${isFixed ? 'is-fixed' : ''}"
               style="${sel === opt.code ? `border-color:${field.color};background:${field.color}18` : ''}"
               onclick="${isFixed ? '' : `selectField('${field.id}', '${opt.code}', '${field.color}')`}">
            <span class="opt-code" style="${sel === opt.code ? `color:${field.color}` : ''}">${opt.code}</span>
            <span class="opt-desc">${opt.desc}</span>
          </div>`).join('')}
      </div>
    </div>`;
  }).join('');

  // Suffixes
  if (spec.suffixes?.length) {
    document.getElementById('suffixNotes').style.display = 'block';
    document.getElementById('suffixContent').innerHTML = spec.suffixes.map(s =>
      `<div class="suffix-row"><span class="suffix-code">${s.code}</span><span class="suffix-desc">${s.desc}</span></div>`
    ).join('');
  } else {
    document.getElementById('suffixNotes').style.display = 'none';
  }

  // Notes
  if (spec.notes?.length) {
    document.getElementById('specNotes').style.display = 'block';
    document.getElementById('specNotesContent').innerHTML = spec.notes.map((n, i) =>
      `<div class="spec-note-row"><span class="spec-note-num">${i+1}.</span>${n}</div>`
    ).join('');
  } else {
    document.getElementById('specNotes').style.display = 'none';
  }

  updatePNDisplay();
}

function selectField(fieldId, code, color) {
  selections[fieldId] = code;
  const specDef = SPECS[currentSpec];
  if (specDef.fields.some(f => f.options.some(o => o.when))) {
    // drop picks that are no longer valid (e.g. insert after shell change), then redraw
    for (const f of specDef.fields)
      if (selections[f.id] && !f.fixed && !visibleOptions(f).some(o => o.code === selections[f.id]))
        delete selections[f.id];
    renderBuilder();
    return;
  }
  // Re-render field options
  const spec = SPECS[currentSpec];
  const field = spec.fields.find(f => f.id === fieldId);
  const fieldEl = document.getElementById(`field-${fieldId}`);
  const headerSel = fieldEl.querySelector('.field-selected');
  if (headerSel) headerSel.textContent = code;
  else fieldEl.querySelector('.field-header').innerHTML +=
    `<span class="field-selected" style="color:${color}">${code}</span>`;

  fieldEl.querySelectorAll('.field-option').forEach(el => {
    const optCode = el.querySelector('.opt-code').textContent;
    const isSel = optCode === code;
    el.classList.toggle('selected', isSel);
    el.style.borderColor = isSel ? color : '';
    el.style.background = isSel ? `${color}18` : '';
    el.querySelector('.opt-code').style.color = isSel ? color : '';
  });

  // Re-render header selected indicator
  fieldEl.querySelector('.field-header').querySelector('.field-selected')
    ? (fieldEl.querySelector('.field-selected').textContent = code)
    : null;

  updatePNDisplay();
}

function buildPN() {
  const spec = SPECS[currentSpec];
  let pn = '';
  for (const field of spec.fields) {
    const val = field.fixed ? field.options[0].code : (selections[field.id] || '');
    pn += val;
    if (currentSpec.startsWith('ms') && field.id === 'shell_size') pn += '-';
    if (currentSpec === 'ms26482' && field.id === 'shell_size') {
      const ins = selections['insert'] || '';
      if (ins) { pn += ins; delete selections['insert']; }
    }
  }
  // For 5015 and 26482, insert format is shell-insert
  return pn;
}

function buildPNSegments() {
  const spec = SPECS[currentSpec];
  const segments = [];
  for (const field of spec.fields) {
    const val = field.fixed ? field.options[0].code : (selections[field.id] || null);
    segments.push({ val, color: field.color, label: field.label, fixed: field.fixed });
  }
  return segments;
}

function updatePNDisplay() {
  const spec = SPECS[currentSpec];
  const segments = buildPNSegments();
  const hasAnySelection = segments.some(s => !s.fixed && s.val);

  let pnHtml = '';
  let fullPN = '';

  for (let i = 0; i < segments.length; i++) {
    const s = segments[i];
    const val = s.val;
    if (val) {
      fullPN += val;
      // Add hyphen separator for MIL-DTL-5015 and 26482 between shell and insert
      if ((currentSpec === 'ms5015' || currentSpec === 'ms26482') &&
          spec.fields[i].id === 'shell_size' && i < segments.length - 1) {
        pnHtml += `<span class="pn-seg" style="color:${s.color};border-color:${s.color}55" title="${s.label}">${val}</span>`;
        fullPN += '-';
        pnHtml += `<span class="pn-sep">-</span>`;
        continue;
      }
      pnHtml += `<span class="pn-seg" style="color:${s.color};border-color:${s.color}55" title="${s.label}">${val}</span>`;
    } else if (!s.fixed) {
      pnHtml += `<span class="pn-seg pn-seg-empty" title="${s.label}">___</span>`;
    }
  }

  const display = document.getElementById('pnDisplay');
  const actions = document.getElementById('pnActions');

  if (hasAnySelection) {
    display.innerHTML = pnHtml;
    display.dataset.pn = fullPN;
    actions.style.display = 'flex';
    const searchLink = document.getElementById('pnSearchLink');
    const decodeLink = document.getElementById('pnDecodeLink');
    if (fullPN && !fullPN.includes('_')) {
      searchLink.href = `/?pn=${encodeURIComponent(fullPN)}`;
      decodeLink.href = `/decode?pn=${encodeURIComponent(fullPN)}`;
    }
  } else {
    display.innerHTML = `<span class="pn-seg-placeholder">Select fields below to build a part number</span>`;
    actions.style.display = 'none';
  }
}

function copyPN() {
  const pn = document.getElementById('pnDisplay').dataset.pn || '';
  navigator.clipboard.writeText(pn).then(() => {
    const btn = document.querySelector('.pn-copy-btn');
    const orig = btn.textContent;
    btn.textContent = '✓ Copied!';
    btn.style.background = 'var(--green)';
    setTimeout(() => { btn.textContent = orig; btn.style.background = ''; }, 1500);
  });
}

document.addEventListener('DOMContentLoaded', () => {
  loadSpec('d38999_iii');
});
// Override to not use event from loadSpec since it's called on load
function loadSpec(specId) {
  currentSpec = specId;
  selections = {};
  document.querySelectorAll('.spec-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.spec-btn').forEach(b => {
    if (b.getAttribute('onclick')?.includes(specId)) b.classList.add('active');
  });
  renderBuilder();
}
</script>
