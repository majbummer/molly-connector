@page
@model BuilderModel
@{ ViewData["Title"] = "Part Number Builder"; ViewData["BodyClass"] = "page-scroll"; }

<div class="builder-page">

  <div class="builder-hero">
    <h1 class="builder-hero-title">Part Number Builder</h1>
    <p class="builder-hero-sub">Select a connector family, then choose each field to build a valid part number and understand exactly what every character means.</p>
  </div>

  <!-- SPEC SELECTOR -->
  <div class="spec-selector">
    <button class="spec-btn active" onclick="loadSpec('d38999_iii')">D38999 Series III/IV</button>
    <button class="spec-btn" onclick="loadSpec('d38999_i')">D38999 Series I (MS274xx)</button>
    <button class="spec-btn" onclick="loadSpec('d38999_ii')">D38999 Series II (MS274xx)</button>
    <button class="spec-btn" onclick="loadSpec('ms26482')">MIL-DTL-26482</button>
    <button class="spec-btn" onclick="loadSpec('ms5015')">MIL-DTL-5015</button>
  </div>

  <!-- LIVE PART NUMBER DISPLAY -->
  <div class="pn-display-wrap">
    <div class="pn-display" id="pnDisplay">
      <span class="pn-seg-placeholder">Select fields below to build a part number</span>
    </div>
    <div class="pn-actions" id="pnActions" style="display:none">
      <a class="pn-search-btn" id="pnSearchLink" href="/" target="_blank">Search this PN →</a>
      <a class="pn-decode-btn" id="pnDecodeLink" href="/decode" target="_blank">Decode this PN →</a>
      <button class="pn-copy-btn" onclick="copyPN()">Copy PN</button>
    </div>
  </div>

  <!-- FIELD BUILDER PANELS -->
  <div class="builder-fields" id="builderFields"></div>

  <!-- SUFFIX NOTES -->
  <div class="suffix-notes" id="suffixNotes" style="display:none">
    <div class="suffix-notes-title">Optional Suffix Codes</div>
    <div id="suffixContent"></div>
  </div>

  <!-- SPEC NOTES -->
  <div class="spec-notes" id="specNotes" style="display:none">
    <div class="spec-notes-title">Notes</div>
    <div id="specNotesContent"></div>
  </div>

</div>

