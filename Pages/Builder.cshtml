function insertSizes(i) {
  return [['22D', i.C22D], ['20', i.C20], ['16', i.C16], ['12', i.C12]]
    .filter(([, n]) => n).map(([sz, n]) => `${n} × #${sz}`)
    .concat(i.Other ? [i.Other] : []).join(', ');
}
function inactiveTag(i) {
  return i.Inactive ? ' · inactive for new design' : '';
}
function seriesInserts(key) {   // key: 'SeriesI' or 'SeriesII'
  return D38999_INSERTS.filter(i => i[key]).map(i => {
    const [shell, arr] = i[key].split('-');
    return { code: arr, desc: `${i[key]} — ${i.Total} contacts (${insertSizes(i)})${inactiveTag(i)}`,
