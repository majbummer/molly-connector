// ── Verified D38999 insert data (single source: Services/D38999Guide.cs) ─────────
const D38999_INSERTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ConnectorDB.Services.D38999Guide.Inserts));
const HERM_SHEETS = ['21','23','25','27','41','43','45','48'];
const isHerm = s => HERM_SHEETS.includes(s.shell_style);
const isIV = s => (s.shell_style || '').startsWith('4');
function insertSizes(i) {
  return [['22D', i.C22D], ['20', i.C20], ['16', i.C16], ['12', i.C12]]
    .filter(([, n]) => n).map(([sz, n]) => `${n} × #${sz}`).join(', ');
}
function seriesInserts(key) {   // key: 'SeriesI' or 'SeriesII'
  return D38999_INSERTS.filter(i => i[key]).map(i => {
    const [shell, arr] = i[key].split('-');
    return { code: arr, desc: `${i[key]} — ${i.Total} contacts (${insertSizes(i)})`,
             when: s => !s.shell_number || parseInt(s.shell_number, 10) === parseInt(shell, 10) };
  });
}
const visibleOptions = (field) => field.options.filter(o => !o.when || o.when(selections));

