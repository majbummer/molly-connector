@page
@model ContactsModel
@{ ViewData["Title"] = "Contacts"; ViewData["BodyClass"] = "page-scroll"; }

<div class="contacts-page">
<h1 class="sr-only">M39029 Contact Reference</h1>

  <div class="contacts-hero">
    <h1 class="contacts-hero-title">Contact Reference</h1>
    <p class="contacts-hero-sub">
      M39029 series crimp contacts — wire gauge ranges, strip lengths,
      crimper tools, positioners, insertion/extraction tools, and compatible connectors.
    </p>
  </div>

  <div id="contactsList" class="contacts-grid">
    <div class="loading"><div class="spinner"></div>Loading contacts…</div>
  </div>

  <div id="contactDetail" class="contact-detail-wrap" style="display:none"></div>

</div>

@section Scripts {
<script>
async function fetchJson(url) {
  try { const r = await fetch(url); return r.ok ? r.json() : null; } catch { return null; }
}

async function loadContacts() {
  const contacts = await fetchJson('/api/contacts');
  if (!contacts) return;

  // Group by contact size
  const groups = {};
  contacts.forEach(c => {
    const key = `Size ${c.contact_size}`;
    if (!groups[key]) groups[key] = [];
    groups[key].push(c);
  });

  const SIZE_COLORS = {
    '8': '#f55f5f', '12': '#f5883a', '16': '#f5a623',
    '20': '#2dd67a', '22D': '#4eb4f5', '22E': '#4eb4f5',
    '22M': '#b87af5', '23': '#56d6c8', '20 (D-Sub)': '#e0a0f5'
  };

  let html = '';
  Object.entries(groups).forEach(([group, items]) => {
    html += `<div class="contact-group">
      <div class="contact-group-title">${group}</div>
      <div class="contact-cards">`;
    items.forEach(c => {
      const color = SIZE_COLORS[c.contact_size] || '#f5a623';
      const genderIcon = c.gender === 'Pin' ? '⊕' : '⊖';
      html += `<div class="contact-card" onclick="loadContact('${c.part_number}')">
        <div class="contact-card-pn" style="color:${color}">${c.part_number}</div>
        <div class="contact-card-type">${genderIcon} ${c.gender} · Size ${c.contact_size}</div>
        <div class="contact-card-wire">AWG ${c.wire_gauge_range}</div>
        <div class="contact-card-stats">
          <span>Strip: ${c.default_strip_length}"</span>
          <span>${c.connector_count?.toLocaleString() || 0} connectors</span>
        </div>
        <div class="contact-card-crimper">${c.crimper_tool || '—'}</div>
      </div>`;
    });
    html += `</div></div>`;
  });

  document.getElementById('contactsList').innerHTML = html;

  // Check URL for a specific contact
  const urlPn = new URLSearchParams(window.location.search).get('pn');
  if (urlPn) loadContact(urlPn);
}

async function loadContact(partNumber) {
  window.history.pushState({ pn: partNumber }, '', `/contacts?pn=${encodeURIComponent(partNumber)}`);
  document.title = `${partNumber} — Molly Connector`;

  // Highlight selected card
  document.querySelectorAll('.contact-card').forEach(el =>
    el.classList.toggle('active', el.querySelector('.contact-card-pn')?.textContent === partNumber));

  const detail = document.getElementById('contactDetail');
  detail.style.display = 'block';
  detail.innerHTML = '<div class="loading"><div class="spinner"></div>Loading…</div>';
  detail.scrollIntoView({ behavior: 'smooth', block: 'start' });

  const data = await fetchJson('/api/contacts/' + encodeURIComponent(partNumber));
  if (!data) {
    detail.innerHTML = `<div style="padding:30px;color:var(--text-dim)">Contact not found.</div>`;
    return;
  }

  const c = data.contact;
  const connectors = data.connectors || [];

  // Sample connectors by spec
  const bySpec = {};
  connectors.forEach(cn => {
    if (!bySpec[cn.spec]) bySpec[cn.spec] = [];
    bySpec[cn.spec].push(cn);
  });

  const specRows = Object.entries(bySpec).map(([spec, cns]) =>
    `<div class="compat-spec-row">
      <div class="compat-spec-name">${spec}</div>
      <div class="compat-spec-count">${cns.length.toLocaleString()} connectors</div>
      <div class="compat-spec-sample">${cns.slice(0,3).map(cn =>
        `<a href="/?pn=${encodeURIComponent(cn.PartNumber)}" class="compat-pn-link">${cn.PartNumber}</a>`
      ).join('')}${cns.length > 3 ? `<span class="compat-more">+${cns.length-3} more</span>` : ''}</div>
    </div>`
  ).join('');

  const totalConnectors = connectors.length;

  detail.innerHTML = `
    <div class="contact-detail-card">
      <div class="contact-detail-header">
        <div>
          <div class="contact-detail-pn">${c.part_number}</div>
          <div class="contact-detail-sub">${c.slash_sheet} · Size ${c.contact_size} · ${c.gender}</div>
        </div>
        <div class="contact-detail-tags">
          <span class="ctag ctag-size">Size ${c.contact_size}</span>
          <span class="ctag ctag-gender">${c.gender === 'Pin' ? '⊕ Pin (Male)' : '⊖ Socket (Female)'}</span>
          <span class="ctag ctag-term">${c.termination}</span>
        </div>
      </div>

      <div class="contact-detail-grid">

        <div class="cd-section">
          <div class="cd-section-title">Wire & Strip</div>
          <div class="cd-row"><span class="cd-label">Wire Gauge Range</span><span class="cd-value highlight">AWG ${c.wire_gauge_range}</span></div>
          <div class="cd-row"><span class="cd-label">Strip Length Min</span><span class="cd-value">${c.strip_length_min}"</span></div>
          <div class="cd-row"><span class="cd-label">Strip Length Max</span><span class="cd-value">${c.strip_length_max}"</span></div>
          <div class="cd-row"><span class="cd-label">Default Strip</span><span class="cd-value highlight">${c.default_strip_length}"</span></div>
        </div>

        <div class="cd-section">
          <div class="cd-section-title">Material</div>
          <div class="cd-row"><span class="cd-label">Contact Material</span><span class="cd-value">${c.contact_material || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Plating</span><span class="cd-value">${c.plating || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Termination</span><span class="cd-value">${c.termination || '—'}</span></div>
        </div>

        <div class="cd-section">
          <div class="cd-section-title">Crimping Tooling</div>
          <div class="cd-row"><span class="cd-label">Crimper</span><span class="cd-value highlight">${c.crimper_tool || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Positioner</span><span class="cd-value highlight">${c.positioner || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Locator / Die</span><span class="cd-value">${c.locator || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Tool Family</span><span class="cd-value">${c.tool_family || '—'}</span></div>
        </div>

        <div class="cd-section">
          <div class="cd-section-title">Insertion & Extraction</div>
          <div class="cd-row"><span class="cd-label">Inserter</span><span class="cd-value">${c.inserter_tool || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Extractor</span><span class="cd-value">${c.extractor_tool || '—'}</span></div>
          <div class="cd-row"><span class="cd-label">Compatible Specs</span><span class="cd-value">${c.compatible_specs || '—'}</span></div>
        </div>

      </div>

      ${c.notes ? `<div class="cd-notes">ℹ ${c.notes}</div>` : ''}

      <div class="cd-compat">
        <div class="cd-compat-title">Compatible Connectors
          <span class="cd-compat-count">${totalConnectors.toLocaleString()} total</span>
          ${totalConnectors === 100 ? '<span class="cd-compat-limit">(showing first 100)</span>' : ''}
        </div>
        ${specRows || '<div style="padding:12px;color:var(--text-faint);font-size:12px">No connectors found for this contact.</div>'}
      </div>
    </div>`;
}

window.addEventListener('popstate', e => {
  const pn = e.state?.pn;
  if (pn) loadContact(pn);
  else {
    document.getElementById('contactDetail').style.display = 'none';
    document.querySelectorAll('.contact-card').forEach(el => el.classList.remove('active'));
  }
});

loadContacts();
</script>
}
