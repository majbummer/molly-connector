<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Molly Connector</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Free MIL-spec connector reference — search 770,000+ part numbers, decode part numbers, find mating connectors, contact tooling, and engineering reference data.")">
    <meta name="keywords" content="MIL-DTL-38999, D38999, MIL-DTL-5015, connector reference, MIL-spec connector, part number decoder, M39029 contacts, circular connector">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://mollyconnector.com@(Context.Request.Path.Value?.TrimEnd('/') ?? "")">
    <meta property="og:title" content="@(ViewData["Title"]) — Molly Connector">
    <meta property="og:description" content="@(ViewData["Description"] ?? "Free MIL-spec connector reference — 770,000+ connectors, part number decoder, contact tooling, and engineering reference.")">
    <meta property="og:url" content="https://mollyconnector.com@(Context.Request.Path)">
    <meta property="og:type" content="website">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"])">
    <header>
        <a class="logo" href="/">MOLLY<em>CONNECTOR</em></a>
        <nav class="main-nav">
            <a class="nav-link" href="/">Search</a>
            <a class="nav-link" href="/decode">Decoder</a>
            <a class="nav-link" href="/builder">PN Builder</a>
            <a class="nav-link" href="/d38999">D38999 Guide</a>
            <a class="nav-link" href="/contacts">Contacts</a>
            <a class="nav-link" href="/reference">Reference</a>
            <a class="nav-link" href="/donate">Support Us</a>
        </nav>
        <div class="stat-chips" id="statsChips"><div class="stat-chip pulse">Loading…</div></div>
    </header>
    @RenderBody()
    <footer class="site-footer">A Plant 69 Holdings project</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
